# ==============================================================================
# IPATH TALENT MATCH - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI API (Core AI Agent for Parsing, Scoring, and Email Drafts)
# ------------------------------------------------------------------------------
# For IT Team: Generate an enterprise API key linked to iPath Infotech's corporate
# Google Cloud / Google AI account at https://aistudio.google.com/app/apikey.
# Attaching corporate billing/credits ensures all usage is billed to company quotas.
GEMINI_API_KEY="YOUR_CORPORATE_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 2. APPLICATION HOSTING
# ------------------------------------------------------------------------------
# The public/internal URL where the app is hosted (e.g. https://talentmatch.ipathinfotech.com)
APP_URL="http://localhost:3000"
PORT=3000

# ------------------------------------------------------------------------------
# 3. CORPORATE SMTP EMAIL RELAY (Optional for live email dispatch)
# ------------------------------------------------------------------------------
# Configure if the IT team wants outgoing candidate emails (shortlist/rejection)
# to be dispatched directly through iPath Infotech's corporate mail servers.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="hr@ipathinfotech.com"
# SMTP_PASS="corporate-secure-app-password"
# SMTP_FROM="iPath Infotech Careers <hr@ipathinfotech.com>"
